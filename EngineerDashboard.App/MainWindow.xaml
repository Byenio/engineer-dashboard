<Window x:Class="EngineerDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:EngineerDashboard.App.Converters"
        mc:Ignorable="d"
        Title="Race Engineer Dashboard" Height="800" Width="1600"
        Background="#121212"
        Foreground="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="20 10 10 10"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
            
            <ui:Button Command="{Binding ShowDriversPageCommand}" Padding="10,10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/drivers-table-icon.png" Width="16" Height="16" />
                </StackPanel>
            </ui:Button>
            
            <Button Command="{Binding ShowCarSetupCommand}" Padding="10,10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/car-data-icon.png" Width="16" Height="16" />
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ShowChartsPageCommand}" Padding="10,10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/charts-icon.png" Width="16" Height="16" />
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ShowInputsAndTelemetryPageCommand}" Padding="10,10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/inputs-icon.png" Width="16" Height="16" />
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ShowDatabaseCommand}" Padding="10,10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/database-icon.png" Width="16" Height="16" />
                </StackPanel>
            </Button>
        </StackPanel>
        
        <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                        Margin=" 0 10"
                        Content="{Binding SessionInfoView}" />
        
        <ContentControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                        Content="{Binding CurrentPageView}" />
        
    </Grid>
</Window>
