<Window x:Class="EngineerDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Race Engineer Dashboard" Height="1000" Width="1800"
        Background="#121212"
        Foreground="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="570" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        
        <UserControl x:Name="SessionInfoView" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0 10" />
        <UserControl x:Name="DriversTableView" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" />
        <UserControl x:Name="TyreCardView" Grid.Row="2" Grid.Column="1" />
        <UserControl x:Name="LapTimeChartView" Grid.Row="2" Grid.Column="2" />
        <UserControl x:Name="TyreWearChartView" Grid.Row="2" Grid.Column="3" />
    </Grid>
</Window>
