<UserControl x:Class="EngineerDashboard.App.Views.RaceLapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EngineerDashboard.App.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:EngineerDashboard.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="NonInteractiveListView" TargetType="{x:Type ui:ListViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <FontFamily x:Key="JetBrainsMonoExtraBold">pack://application,,,/Assets/Fonts/#JetBrains Mono ExtraBold</FontFamily>
        <FontFamily x:Key="JetBrainsMonoRegular">pack://application,,,/Assets/Fonts/#JetBrains Mono Regular</FontFamily>
        
        <Style x:Key="HeaderContent" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoExtraBold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="12 10" />
        </Style>
        
        <Style x:Key="ButtonContent" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoExtraBold}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="CellContent" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="12 5" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20 40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20*" />
        </Grid.ColumnDefinitions>
        
        <ui:Button Grid.Row="0" Grid.Column="0" Margin="12 10" Command="{Binding GoBackCommand}">
            <ui:TextBlock Text="&lt;-" Style="{StaticResource ButtonContent}" />
        </ui:Button>
        
        <Grid Grid.Row="0" Grid.Column="1" Margin="200 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Lap" Style="{StaticResource HeaderContent}" />
            <ui:TextBlock Grid.Column="1" Text="#" Style="{StaticResource HeaderContent}" />
            <ui:TextBlock Grid.Column="2" Text="Interval" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
            <ui:TextBlock Grid.Column="3" Text="Leader" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
            <ui:TextBlock Grid.Column="4" Text="Tyre" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
            <ui:TextBlock Grid.Column="5" Text="Wear" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
            <ui:TextBlock Grid.Column="6" Text="Last Lap" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
            <ui:TextBlock Grid.Column="7" Text="Pit Stop" Style="{StaticResource HeaderContent}" TextAlignment="Right" />
        </Grid>
        
        <ui:ListView Grid.Row="1" Grid.Column="1"
                     ItemsSource="{Binding Laps}"
                     IsSynchronizedWithCurrentItem="True"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource NonInteractiveListView}"
                     Margin="200 0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Lap.lap_number}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="1" Text="{Binding Lap.current_position, StringFormat='P{0}'}" Style="{StaticResource CellContent}" />
                        <TextBlock Grid.Column="2" Text="{Binding DeltaFront}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding DeltaLeader}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding TyreCompound}" Style="{StaticResource CellContent}" TextAlignment="Right" Foreground="{Binding TyreBrush}" />
                        <TextBlock Grid.Column="5" Text="{Binding TyreWear}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="{Binding LastLapTime}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="{Binding PitStopTimeString}" Style="{StaticResource CellContent}" TextAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</UserControl>
