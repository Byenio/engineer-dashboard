<UserControl x:Class="EngineerDashboard.App.Views.CarInfoCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EngineerDashboard.App.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:EngineerDashboard.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <FontFamily x:Key="JetBrainsMonoBold">pack://application,,,/Assets/Fonts/#JetBrains Mono Regular</FontFamily>
        
        <Style x:Key="Text" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoBold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="4 1" />
        </Style>
        
        <converters:TyreCompoundConverter x:Key="TyreCompoundConverter"/>
        <converters:TyreToBrushConverter x:Key="TyreToBrushConverter"/>
        <converters:WearToTextDecorationConverter x:Key="WearToTextDecorationConverter"/>
        <converters:TyreVisibilityConverter x:Key="TyreVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <lvc:PieChart
            Grid.Column="0"
            Grid.Row="0"
            Series="{Binding ThrottleSeries}"
            Width="100"
            Height="100"
            InitialRotation="135"
            MaxValue="100"
            MaxAngle="270"/>
        
        <lvc:PieChart
            Grid.Column="1"
            Grid.Row="0"
            Series="{Binding BrakeSeries}"
            Width="100"
            Height="100"
            InitialRotation="135"
            MaxValue="100"
            MaxAngle="270"/>
        
        <lvc:PieChart
            Grid.Column="2"
            Grid.Row="0"
            Series="{Binding SpeedSeries}"
            Width="100"
            Height="100"
            InitialRotation="135"
            MaxValue="380"
            MaxAngle="270"/>
        
        <lvc:PieChart
            Grid.Column="3"
            Grid.Row="0"
            Series="{Binding ErsSeries}"
            Width="100"
            Height="100"
            InitialRotation="135"
            MaxValue="100"
            MaxAngle="270"/>
        
        <ui:TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="Throttle"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Text="Brake"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="1"
            Grid.Column="2"
            Text="Speed"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="1"
            Grid.Column="3"
            Text="ERS"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:NavigationViewItemSeparator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"/>
        
        <ui:TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Text="DRS"
            Foreground="{Binding DrsActiveColor}"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="3"
            Grid.Column="1"
            Text="PIT"
            Foreground="{Binding PitLimiterColor}"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="3"
            Grid.Column="2"
            Text="{Binding VehicleFiaFlag}"
            Foreground="{Binding VehicleFiaFlagColor}"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="3"
            Grid.Column="3"
            Text="{Binding ErsDeployModeString}"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <ui:TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Text="Available Tyres"
            TextAlignment="Center"
            Style="{StaticResource Text}"/>
        
        <StackPanel Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="600" Padding="20 0">
                <ItemsControl ItemsSource="{Binding TyreSets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding VisualTyreCompound, Converter={StaticResource TyreCompoundConverter}}"
                                       FontSize="20" Margin="10 0" FontFamily="{StaticResource JetBrainsMonoBold}"
                                       ToolTip="{Binding TyreInfo}"
                                       ToolTipService.InitialShowDelay="100">
                                <TextBlock.Foreground>
                                    <Binding Path="VisualTyreCompound" Converter="{StaticResource TyreToBrushConverter}"/>
                                </TextBlock.Foreground>
                                <TextBlock.TextDecorations>
                                    <Binding Path="Wear" Converter="{StaticResource WearToTextDecorationConverter}"/>
                                </TextBlock.TextDecorations>
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource TyreVisibilityConverter}">
                                        <Binding Path="Available"/>
                                        <Binding Path="Fitted"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
